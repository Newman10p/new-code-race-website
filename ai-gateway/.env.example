# Copy to .env and fill in. NEVER commit the real .env file!

# Shared secret between YOUR backend and this gateway (generate: `openssl rand -hex 32`)
INTERNAL_API_TOKEN=change-me

# Default free provider used when the request doesn't specify one: openrouter | groq | ollama
AI_DEFAULT_PROVIDER=openrouter

# --- Free cloud providers (pick at least one) ---
# OpenRouter: https://openrouter.ai/keys  (free signup, has :free models)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Groq: https://console.groq.com/keys  (free signup, very fast)
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# --- Free local option (no key needed): Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# --- Limits ---
AI_REQUEST_TIMEOUT=60
AI_RATE_LIMIT_PER_MINUTE=30
# Per-user 24h token budget. 0 = disabled (only enforced when USAGE_DB_PATH is set,
# since the quota check reads from the usage store).
AI_DAILY_TOKEN_LIMIT_PER_USER=0
# Optional comma-separated allowlist; empty = any model allowed
AI_ALLOWED_MODELS=

# --- Hardening (optional but recommended for production) ---
# Redis URL for the distributed rate limiter. Empty -> in-memory limiter
# (single-process, resets on restart). docker-compose sets this automatically.
REDIS_URL=
# SQLite path for usage persistence. Empty -> usage NOT persisted and /v1/usage
# returns 503. In docker-compose this is /data/usage.db (a mounted volume).
# Tests can set USAGE_DB_PATH=:memory: but each connection then sees its own DB.
USAGE_DB_PATH=

# Embedding model used by POST /v1/embeddings (OpenRouter free tier)
OPENROUTER_DEFAULT_EMBEDDING_MODEL=baichuan-ai/baichuan-embedding:free

# Port the gateway listens on (only used by docker-compose's host mapping)
GATEWAY_PORT=8000
